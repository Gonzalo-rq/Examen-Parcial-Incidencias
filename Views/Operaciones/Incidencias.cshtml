@model IEnumerable<IncidenciasApp.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias Operativas";
    string fuente = ViewBag.FuenteDatos as string ?? "Base de Datos";
    string currentQuery = ViewBag.Query as string ?? "";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Incidencias abiertas con consulta rápida</h1>
        <span class="badge bg-primary fs-6 py-2 px-3">
            ⚡ @fuente
        </span>
    </div>

    <!-- Buscador Algolia en servidor -->
    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Incidencias" class="row g-2 align-items-center">
                <div class="col-md-9 col-sm-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white">🔍</span>
                        <input type="text" name="q" value="@currentQuery" class="form-control" placeholder="Buscar por estación o descripción (ej: Frenos, Miraflores, GPS)..." />
                    </div>
                </div>
                <div class="col-md-3 col-sm-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Buscar (Algolia)</button>
                    @if (!string.IsNullOrEmpty(currentQuery))
                    {
                        <a asp-action="Incidencias" class="btn btn-outline-secondary">Limpiar</a>
                    }
                </div>
            </form>
            @if (!string.IsNullOrEmpty(currentQuery))
            {
                <div class="mt-2 text-muted small">
                    Resultados para: <strong>"@currentQuery"</strong> (@Model.Count() encontrados)
                </div>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No se encontraron incidencias abiertas en el sistema.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-striped align-middle mb-0 bg-white">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 5%;">ID</th>
                        <th style="width: 25%;">Estación</th>
                        <th style="width: 35%;">Descripción</th>
                        <th style="width: 10%;">Prioridad</th>
                        <th style="width: 10%;">Estado</th>
                        <th style="width: 15%;">Acción</th>
                    </tr>
                </thead>
                <tbody id="tabla-incidencias-body">
                    @foreach (var item in Model)
                    {
                        <tr id="fila-incidencia-@item.Id">
                            <td><strong>#@item.Id</strong></td>
                            <td>@item.Estacion</td>
                            <td>@item.Descripcion</td>
                            <td>
                                @if (item.Prioridad == "Alta")
                                {
                                    <span class="badge bg-danger">Alta</span>
                                }
                                else if (item.Prioridad == "Media")
                                {
                                    <span class="badge bg-warning text-dark">Media</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Baja</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success" id="estado-badge-@item.Id">@item.Estado</span>
                            </td>
                            <td>
                                <form asp-action="Cerrar" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Seguro que deseas cerrar la incidencia #@item.Id?');">
                                        Cerrar Incidencia
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
